    <jointvel name="RL_toe_f2_vel" joint="RL_toe_f2_j"/>
    <jointvel name="RL_toe_b_vel" joint="RL_toe_b_j"/>

    <jointpos name="RR_abd_pos" joint="RR_abd"/>
    <jointpos name="RR_hip_pos" joint="RR_hip_pitch"/>
    <jointpos name="RR_knee_pos" joint="RR_knee"/>
    <jointpos name="RR_ankle_pos" joint="RR_ankle"/>
    <jointpos name="RR_toe_f1_pos" joint="RR_toe_f1_j"/>
    <jointpos name="RR_toe_f2_pos" joint="RR_toe_f2_j"/>
    <jointpos name="RR_toe_b_pos" joint="RR_toe_b_j"/>
    <jointvel name="RR_abd_vel" joint="RR_abd"/>
    <jointvel name="RR_hip_vel" joint="RR_hip_pitch"/>
    <jointvel name="RR_knee_vel" joint="RR_knee"/>
    <jointvel name="RR_ankle_vel" joint="RR_ankle"/>
    <jointvel name="RR_toe_f1_vel" joint="RR_toe_f1_j"/>
    <jointvel name="RR_toe_f2_vel" joint="RR_toe_f2_j"/>
    <jointvel name="RR_toe_b_vel" joint="RR_toe_b_j"/>

    <!-- IMU 9축 + 속도계 (BNO085급, 몸통 중심) -->
    <framequat name="imu_orient" objtype="site" objname="imu_site"/>
    <gyro name="imu_gyro" site="imu_site"/>
    <accelerometer name="imu_acc" site="imu_site"/>
    <magnetometer name="imu_mag" site="imu_site"/>
    <velocimeter name="imu_vel" site="imu_site"/>

    <!-- rangefinder: 전방 + 절벽감지 좌/우 (머리에 장착, 목과 함께 회전) -->
    <rangefinder name="rf_forward" site="rf_fwd"/>
    <rangefinder name="rf_cliff_left" site="rf_cliff_l"/>
    <rangefinder name="rf_cliff_right" site="rf_cliff_r"/>

    <!-- 접촉 센서 27개: 머리5 + 몸통6 + 발바닥4 + 발가락끝12 -->
    <touch name="head_nose_t" site="head_nose_touch"/>
    <touch name="head_top_t" site="head_top_touch"/>
    <touch name="head_chin_t" site="head_chin_touch"/>
    <touch name="head_cheek_l_t" site="head_cheek_l_touch"/>
    <touch name="head_cheek_r_t" site="head_cheek_r_touch"/>
    <touch name="belly_f_t" site="belly_f_touch"/>
    <touch name="back_f_t" site="back_f_touch"/>
    <touch name="flank_l_f_t" site="flank_l_f_touch"/>
    <touch name="flank_r_f_t" site="flank_r_f_touch"/>
    <touch name="bumper_f_t" site="bumper_f_touch"/>
    <touch name="belly_b_t" site="belly_b_touch"/>
    <touch name="back_b_t" site="back_b_touch"/>
    <touch name="flank_l_b_t" site="flank_l_b_touch"/>
    <touch name="flank_r_b_t" site="flank_r_b_touch"/>
