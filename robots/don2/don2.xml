            </body>
          </body>
        </body>
      </body>

      <!-- ================= RR 다리 ================= -->
      <body name="RR_hip" pos="-0.13 -0.09 -0.02">
        <joint name="RR_abd" axis="1 0 0" range="-0.5 0.5" class="xm430"/>
        <geom class="xm430"/>
