    <jointpos name="FR_hip_pos" joint="FR_hip_pitch"/>
    <jointpos name="FR_knee_pos" joint="FR_knee"/>
    <jointpos name="FR_ankle_pos" joint="FR_ankle"/>
    <jointpos name="FR_toe_f1_pos" joint="FR_toe_f1_j"/>
