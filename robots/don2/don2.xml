              <geom name="FR_foot_plate" type="box" size="0.032 0.016 0.005" pos="0.008 0 -0.022" mass="0.020"
                    rgba="0.3 0.3 0.3 1" friction="1.2 0.01 0.001"/>
              <site name="FR_pulley_f1" pos="0.031 0.008 -0.025" class="tendonsite"/>
              <site name="FR_pulley_f2" pos="0.031 -0.008 -0.025" class="tendonsite"/>
              <site name="FR_pulley_b" pos="-0.019 0 -0.025" class="tendonsite"/>
              <site name="FR_sole_touch" class="touchsite" type="box" pos="0.008 0 -0.028" size="0.016 0.009 0.0025"/>
              <body name="FR_toe_f1" pos="0.039 0.009 -0.022">
                <joint name="FR_toe_f1_j" class="toe" axis="0 1 0"/>
                <geom class="toe" fromto="0 0 0 0.040 0 0"/>
                <site name="FR_toe_f1_insert" pos="0.008 0 -0.010" class="tendonsite"/>
                <site name="FR_toe_f1_touch" class="touchsite" pos="0.040 0 0" size="0.008"/>
              </body>
              <body name="FR_toe_f2" pos="0.039 -0.009 -0.022">
                <joint name="FR_toe_f2_j" class="toe" axis="0 1 0"/>
                <geom class="toe" fromto="0 0 0 0.040 0 0"/>
                <site name="FR_toe_f2_insert" pos="0.008 0 -0.010" class="tendonsite"/>
                <site name="FR_toe_f2_touch" class="touchsite" pos="0.040 0 0" size="0.008"/>
              </body>
              <body name="FR_toe_b" pos="-0.027 0 -0.022">
                <joint name="FR_toe_b_j" class="toe" axis="0 -1 0" range="-0.25 1.8"/>
                <geom class="toe" fromto="0 0 0 -0.034 0 0" mass="0.007"/>
                <site name="FR_toe_b_insert" pos="-0.007 0 -0.010" class="tendonsite"/>
                <site name="FR_toe_b_touch" class="touchsite" pos="-0.034 0 0" size="0.008"/>
              </body>
            </body>
          </body>
        </body>
      </body>

      </body> <!-- torso_front 끝 -->

      <!-- ================= RL 다리 (하체 소속) ================= -->
      <body name="RL_hip" pos="-0.13 0.09 -0.02">
        <joint name="RL_abd" axis="1 0 0" range="-0.5 0.5" class="xm430"/>
        <geom class="xm430"/>
        <body name="RL_thigh" pos="0 0.045 0">
          <joint name="RL_hip_pitch" axis="0 1 0" range="-1.5 1.5" class="xm430"/>
          <geom class="xm430"/>
          <geom name="RL_thigh_link" class="link" fromto="0 0 0 0 0 -0.13" size="0.010" mass="0.040"/>
