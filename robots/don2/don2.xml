    <touch name="FL_toe_f2_t" site="FL_toe_f2_touch"/>
    <touch name="FL_toe_b_t" site="FL_toe_b_touch"/>
    <touch name="FR_sole_t" site="FR_sole_touch"/>
    <touch name="FR_toe_f1_t" site="FR_toe_f1_touch"/>
    <touch name="FR_toe_f2_t" site="FR_toe_f2_touch"/>
    <touch name="FR_toe_b_t" site="FR_toe_b_touch"/>
    <touch name="RL_sole_t" site="RL_sole_touch"/>
    <touch name="RL_toe_f1_t" site="RL_toe_f1_touch"/>
    <touch name="RL_toe_f2_t" site="RL_toe_f2_touch"/>
    <touch name="RL_toe_b_t" site="RL_toe_b_touch"/>
    <touch name="RR_sole_t" site="RR_sole_touch"/>
    <touch name="RR_toe_f1_t" site="RR_toe_f1_touch"/>
    <touch name="RR_toe_f2_t" site="RR_toe_f2_touch"/>
    <touch name="RR_toe_b_t" site="RR_toe_b_touch"/>

    <!-- 서보 부하(전류 감지 모사): 다리 16 + 허리 3 + 목 2 -->
    <actuatorfrc name="spine_yaw_frc" actuator="spine_yaw_act"/>
    <actuatorfrc name="spine_pitch_frc" actuator="spine_pitch_act"/>
    <actuatorfrc name="spine_roll_frc" actuator="spine_roll_act"/>
    <actuatorfrc name="neck_yaw_frc" actuator="neck_yaw_act"/>
    <actuatorfrc name="neck_pitch_frc" actuator="neck_pitch_act"/>
    <actuatorfrc name="FL_abd_frc" actuator="FL_abd_act"/>
    <actuatorfrc name="FL_hip_frc" actuator="FL_hip_act"/>
    <actuatorfrc name="FL_knee_frc" actuator="FL_knee_act"/>
    <actuatorfrc name="FL_ankle_frc" actuator="FL_ankle_act"/>
    <actuatorfrc name="FR_abd_frc" actuator="FR_abd_act"/>
    <actuatorfrc name="FR_hip_frc" actuator="FR_hip_act"/>
    <actuatorfrc name="FR_knee_frc" actuator="FR_knee_act"/>
