    <jointvel name="FR_toe_f2_vel" joint="FR_toe_f2_j"/>
    <jointvel name="FR_toe_b_vel" joint="FR_toe_b_j"/>

    <jointpos name="RL_abd_pos" joint="RL_abd"/>
    <jointpos name="RL_hip_pos" joint="RL_hip_pitch"/>
    <jointpos name="RL_knee_pos" joint="RL_knee"/>
    <jointpos name="RL_ankle_pos" joint="RL_ankle"/>
    <jointpos name="RL_toe_f1_pos" joint="RL_toe_f1_j"/>
    <jointpos name="RL_toe_f2_pos" joint="RL_toe_f2_j"/>
    <jointpos name="RL_toe_b_pos" joint="RL_toe_b_j"/>
