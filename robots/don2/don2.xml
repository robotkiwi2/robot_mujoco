<mujoco model="don2">
  <!-- don2: 정서-욕구 아키텍처(framework/DESIGN.md)용 사족보행 로봇.
       모든 부품은 실존 제품 스펙 기반 (CLAUDE.md 원칙):
       - 다리 서보: DYNAMIXEL XM430-W350 (82g, 4.1 N·m)
       - 발목/목 서보: DYNAMIXEL XL430-W250 (57g, 1.4 N·m)
       - 발가락 텐던 스풀: DYNAMIXEL XL330-M288 (23g, 0.52 N·m) - 허벅지/종아리 장착
       - 배터리: 3S LiPo 5000mAh (370g, 55.5Wh), 컴퓨터: RPi4급 (100g)
       전력 모델/센서 특성은 robot_config.py 참조. -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <!-- 다리 메인 서보: XM430-W350 (위치제어 서보 그대로 모사) -->
    <default class="xm430">
      <geom type="box" size="0.0143 0.0233 0.017" mass="0.082" contype="0" conaffinity="0" rgba="0.15 0.15 0.2 1"/>
      <joint damping="0.35" armature="0.008" frictionloss="0.06"/>
      <position kp="8" forcerange="-4.1 4.1"/>
    </default>
    <!-- 발목/목 서보: XL430-W250 -->
    <default class="xl430">
      <geom type="box" size="0.0143 0.0233 0.017" mass="0.057" contype="0" conaffinity="0" rgba="0.2 0.2 0.25 1"/>
      <joint damping="0.25" armature="0.005" frictionloss="0.04"/>
      <position kp="4" forcerange="-1.4 1.4"/>
    </default>
    <!-- 발가락 텐던 스풀 모터: XL330-M288 (스풀 r=6mm → 최대 장력 ~86N, 사용범위 0~15N) -->
    <default class="xl330">
      <geom type="box" size="0.010 0.017 0.013" mass="0.023" contype="0" conaffinity="0" rgba="0.25 0.25 0.3 1"/>
    </default>
    <!-- 구조재: 탄소튜브/알루미늄 브래킷 (질량은 각 geom에 명시) -->
    <default class="link">
      <geom type="capsule" rgba="0.6 0.6 0.65 1" friction="1.0 0.01 0.001"/>
    </default>
    <!-- 발가락: 고무 코팅 팁 (마찰 높음), 스프링 복원(신전) + 텐던 굴곡.
         깊은 조임(약 115도)이 가능하도록: 넓은 range + 약한 스프링(0.08) + 굵은 모멘트암(삽입점 10mm) -->
    <default class="toe">
      <joint type="hinge" range="-0.25 2.0" stiffness="0.08" springref="0" damping="0.015" armature="0.0005"/>
      <geom type="capsule" size="0.006" mass="0.008" rgba="0.2 0.2 0.2 1" friction="1.4 0.02 0.002"/>
    </default>
    <!-- 접촉센서 패드: group 1 = 뷰어 기본 표시. 표면에 붉은 반투명 패드로 항상 보임 -->
    <default class="touchsite">
      <site rgba="1 0.15 0.15 0.5" group="1"/>
    </default>
    <default class="mountsite">
      <site rgba="0.3 1 0.3 0.5" group="4" size="0.004"/>
    </default>
    <default class="tendonsite">
      <site rgba="0.9 0.5 0.2 0.6" group="5" size="0.0025"/>
    </default>
  </default>

  <worldbody>
    <!-- ============ 하체(후방 몸통): 배터리 + 뒷다리. 루트 바디 ============ -->
    <body name="torso_rear" pos="0 0 0.30">
      <freejoint/>
      <geom name="torso_rear_frame" type="box" size="0.07 0.08 0.045" pos="-0.08 0 0" mass="0.40"
            rgba="0.3 0.4 0.65 1" friction="1.0 0.005 0.0001"/>
      <!-- 배터리: 3S LiPo 5000mAh, 155x48x26mm, 370g - 하체 하부 배치 -->
      <geom name="battery" type="box" size="0.0775 0.024 0.013" pos="-0.08 0 -0.02" mass="0.37"
            contype="0" conaffinity="0" rgba="0.9 0.7 0.1 1"/>

      <!-- 하체 표면 접촉 센서 5개 -->
      <site name="belly_b_touch" class="touchsite" type="box" pos="-0.08 0 -0.046" size="0.065 0.075 0.004"/>
      <site name="back_b_touch" class="touchsite" type="box" pos="-0.08 0 0.046" size="0.065 0.075 0.004"/>
      <site name="flank_l_b_touch" class="touchsite" type="box" pos="-0.08 0.081 0" size="0.065 0.004 0.04"/>
      <site name="flank_r_b_touch" class="touchsite" type="box" pos="-0.08 -0.081 0" size="0.065 0.004 0.04"/>
      <site name="bumper_b_touch" class="touchsite" type="box" pos="-0.151 0 0" size="0.004 0.075 0.04"/>

      <!-- ============ 상체(전방 몸통): 허리 3자유도(팬/틸트/롤, XM430x3)로 연결 ============ -->
      <body name="torso_front" pos="0.01 0 0">
        <joint name="spine_yaw" axis="0 0 1" range="-0.35 0.35" class="xm430" damping="0.8"/>
        <joint name="spine_pitch" axis="0 1 0" range="-0.3 0.3" class="xm430" damping="0.8"/>
        <joint name="spine_roll" axis="1 0 0" range="-0.25 0.25" class="xm430" damping="0.8"/>
        <!-- 허리 서보 3개 (XM430, 척추부에 물리 배치) -->
        <geom class="xm430" pos="0.015 0.026 0"/>
        <geom class="xm430" pos="0.015 -0.026 0"/>
        <geom class="xm430" pos="0.015 0 0.028"/>
        <geom name="torso_front_frame" type="box" size="0.07 0.08 0.045" pos="0.07 0 0" mass="0.35"
              rgba="0.35 0.45 0.7 1" friction="1.0 0.005 0.0001"/>
        <!-- 온보드 컴퓨터: RPi4급, 100g - 상체 배치 -->
        <geom name="computer" type="box" size="0.035 0.028 0.010" pos="0.05 0 0.02" mass="0.10"
              contype="0" conaffinity="0" rgba="0.1 0.6 0.3 1"/>

        <!-- IMU (BNO085급 9축) 상체 중심 -->
        <site name="imu_site" pos="0.05 0 0.01" class="mountsite"/>
        <!-- 배 밑 바닥색/반사율 센서 (TCS34725급) 마운트 -->
        <site name="ground_sensor_site" pos="0.07 0 -0.047" class="mountsite"/>

        <!-- 상체 표면 접촉 센서 5개 -->
        <site name="belly_f_touch" class="touchsite" type="box" pos="0.07 0 -0.046" size="0.065 0.075 0.004"/>
        <site name="back_f_touch" class="touchsite" type="box" pos="0.07 0 0.046" size="0.065 0.075 0.004"/>
        <site name="flank_l_f_touch" class="touchsite" type="box" pos="0.07 0.081 0" size="0.065 0.004 0.04"/>
        <site name="flank_r_f_touch" class="touchsite" type="box" pos="0.07 -0.081 0" size="0.065 0.004 0.04"/>
        <site name="bumper_f_touch" class="touchsite" type="box" pos="0.141 0 0" size="0.004 0.075 0.04"/>

        <!-- ================= 머리 (전방, 2축 목 + 감각기관 집중) ================= -->
        <body name="neck_base" pos="0.14 0 0.035">
        <joint name="neck_yaw" axis="0 0 1" range="-1.2 1.2" class="xl430"/>
        <geom class="xl430"/>
        <body name="head" pos="0.055 0 0.012">
          <joint name="neck_pitch" axis="0 1 0" range="-0.9 0.6" class="xl430"/>
          <geom class="xl430" pos="-0.012 0 0"/>
          <geom name="head_shell" type="box" size="0.032 0.026 0.022" pos="0.028 0 0.004" mass="0.060"
                rgba="0.4 0.5 0.75 1" friction="1.0 0.005 0.0001"/>

          <!-- 가상센서 마운트: 콧구멍(냄새 좌/우), 광센서 -->
          <site name="nostril_l" pos="0.061 0.013 0.006" class="mountsite"/>
          <site name="nostril_r" pos="0.061 -0.013 0.006" class="mountsite"/>
          <site name="light_sensor_site" pos="0.028 0 0.027" class="mountsite"/>

          <!-- rangefinder 3개: 전방 + 좌/우 절벽감지 (site +Z 방향으로 발사) -->
          <site name="rf_fwd" pos="0.061 0 0.014" zaxis="1 0 0" size="0.003" rgba="0 0.8 1 0.7"/>
          <site name="rf_cliff_l" pos="0.055 0.014 -0.016" zaxis="0.55 0 -0.835" size="0.003" rgba="0 0.8 1 0.7"/>
          <site name="rf_cliff_r" pos="0.055 -0.014 -0.016" zaxis="0.55 0 -0.835" size="0.003" rgba="0 0.8 1 0.7"/>

          <!-- 머리 접촉 센서 5개 -->
          <site name="head_nose_touch" class="touchsite" type="box" pos="0.061 0 0.004" size="0.003 0.024 0.018"/>
          <site name="head_top_touch" class="touchsite" type="box" pos="0.028 0 0.027" size="0.030 0.024 0.003"/>
          <site name="head_chin_touch" class="touchsite" type="box" pos="0.028 0 -0.019" size="0.030 0.024 0.003"/>
          <site name="head_cheek_l_touch" class="touchsite" type="box" pos="0.028 0.027 0.004" size="0.030 0.003 0.018"/>
          <site name="head_cheek_r_touch" class="touchsite" type="box" pos="0.028 -0.027 0.004" size="0.030 0.003 0.018"/>
        </body>
      </body>

      <!-- ================= FL 다리 (상체 소속) ================= -->
      <body name="FL_hip" pos="0.12 0.09 -0.02">
        <joint name="FL_abd" axis="1 0 0" range="-0.5 0.5" class="xm430"/>
        <geom class="xm430"/>
        <body name="FL_thigh" pos="0 0.045 0">
          <joint name="FL_hip_pitch" axis="0 1 0" range="-1.5 1.5" class="xm430"/>
          <geom class="xm430"/>
          <geom name="FL_thigh_link" class="link" fromto="0 0 0 0 0 -0.13" size="0.010" mass="0.040"/>
          <geom class="xm430" pos="0 0 -0.13"/> <!-- 무릎 서보 (허벅지 하단 장착) -->
          <geom class="xl330" pos="-0.014 0 -0.055"/> <!-- 뒷발가락 텐던 스풀 모터 (허벅지 후면) -->
          <site name="FL_spool_b" pos="-0.018 0 -0.060" class="tendonsite"/>
          <body name="FL_calf" pos="0 0 -0.13">
            <joint name="FL_knee" axis="0 1 0" range="-2.4 -0.3" class="xm430"/>
            <geom name="FL_calf_link" class="link" fromto="0 0 0 0 0 -0.13" size="0.008" mass="0.030"/>
            <geom class="xl330" pos="0.013 0.008 -0.050"/>  <!-- 앞발가락1 스풀 (종아리 전면) -->
            <geom class="xl330" pos="0.013 -0.008 -0.050"/> <!-- 앞발가락2 스풀 -->
            <site name="FL_spool_f1" pos="0.017 0.008 -0.056" class="tendonsite"/>
            <site name="FL_spool_f2" pos="0.017 -0.008 -0.056" class="tendonsite"/>
            <site name="FL_calf_back" pos="-0.011 0 -0.095" class="tendonsite"/>
            <geom class="xl430" pos="-0.014 0 -0.108"/> <!-- 발목 서보: 종아리 하단 장착, 브래킷 링키지로 발목 구동(말단 관성 절감) -->
            <body name="FL_foot" pos="0 0 -0.13">
              <joint name="FL_ankle" axis="0 1 0" range="-0.8 1.2" class="xl430"/>
              <geom name="FL_ankle_bracket" type="box" size="0.009 0.007 0.005" mass="0.008"
                    contype="0" conaffinity="0" rgba="0.2 0.2 0.2 1"/>
              <geom name="FL_foot_plate" type="box" size="0.032 0.016 0.005" pos="0.008 0 -0.022" mass="0.020"
                    rgba="0.3 0.3 0.3 1" friction="1.2 0.01 0.001"/>
              <site name="FL_pulley_f1" pos="0.031 0.008 -0.025" class="tendonsite"/>
              <site name="FL_pulley_f2" pos="0.031 -0.008 -0.025" class="tendonsite"/>
              <site name="FL_pulley_b" pos="-0.019 0 -0.025" class="tendonsite"/>
              <site name="FL_sole_touch" class="touchsite" type="box" pos="0.008 0 -0.028" size="0.016 0.009 0.0025"/>
              <body name="FL_toe_f1" pos="0.039 0.009 -0.022">
                <joint name="FL_toe_f1_j" class="toe" axis="0 1 0"/>
                <geom class="toe" fromto="0 0 0 0.040 0 0"/>
                <site name="FL_toe_f1_insert" pos="0.008 0 -0.010" class="tendonsite"/>
                <site name="FL_toe_f1_touch" class="touchsite" pos="0.040 0 0" size="0.008"/>
              </body>
              <body name="FL_toe_f2" pos="0.039 -0.009 -0.022">
                <joint name="FL_toe_f2_j" class="toe" axis="0 1 0"/>
                <geom class="toe" fromto="0 0 0 0.040 0 0"/>
                <site name="FL_toe_f2_insert" pos="0.008 0 -0.010" class="tendonsite"/>
                <site name="FL_toe_f2_touch" class="touchsite" pos="0.040 0 0" size="0.008"/>
              </body>
              <body name="FL_toe_b" pos="-0.027 0 -0.022">
                <joint name="FL_toe_b_j" class="toe" axis="0 -1 0" range="-0.25 1.8"/>
                <geom class="toe" fromto="0 0 0 -0.034 0 0" mass="0.007"/>
                <site name="FL_toe_b_insert" pos="-0.007 0 -0.010" class="tendonsite"/>
                <site name="FL_toe_b_touch" class="touchsite" pos="-0.034 0 0" size="0.008"/>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ================= FR 다리 (상체 소속) ================= -->
      <body name="FR_hip" pos="0.12 -0.09 -0.02">
        <joint name="FR_abd" axis="1 0 0" range="-0.5 0.5" class="xm430"/>
        <geom class="xm430"/>
        <body name="FR_thigh" pos="0 -0.045 0">
          <joint name="FR_hip_pitch" axis="0 1 0" range="-1.5 1.5" class="xm430"/>
          <geom class="xm430"/>
          <geom name="FR_thigh_link" class="link" fromto="0 0 0 0 0 -0.13" size="0.010" mass="0.040"/>
          <geom class="xm430" pos="0 0 -0.13"/>
          <geom class="xl330" pos="-0.014 0 -0.055"/>
          <site name="FR_spool_b" pos="-0.018 0 -0.060" class="tendonsite"/>
          <body name="FR_calf" pos="0 0 -0.13">
            <joint name="FR_knee" axis="0 1 0" range="-2.4 -0.3" class="xm430"/>
            <geom name="FR_calf_link" class="link" fromto="0 0 0 0 0 -0.13" size="0.008" mass="0.030"/>
            <geom class="xl330" pos="0.013 0.008 -0.050"/>
            <geom class="xl330" pos="0.013 -0.008 -0.050"/>
            <site name="FR_spool_f1" pos="0.017 0.008 -0.056" class="tendonsite"/>
            <site name="FR_spool_f2" pos="0.017 -0.008 -0.056" class="tendonsite"/>
            <site name="FR_calf_back" pos="-0.011 0 -0.095" class="tendonsite"/>
            <geom class="xl430" pos="-0.014 0 -0.108"/>
            <body name="FR_foot" pos="0 0 -0.13">
              <joint name="FR_ankle" axis="0 1 0" range="-0.8 1.2" class="xl430"/>
              <geom name="FR_ankle_bracket" type="box" size="0.009 0.007 0.005" mass="0.008"
