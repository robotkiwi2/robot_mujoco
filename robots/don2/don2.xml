  <!-- ================= 텐던 (발가락 굴곡 와이어) ================= -->
  <!-- 앞발가락: 종아리 스풀 → 발 앞 풀리 → 발가락 하면 삽입점. 당기면(단축) 굴곡, 스프링이 신전 복원.
       뒷발가락: 허벅지 스풀 → 종아리 후면 → 발 뒤 풀리 → 삽입점 (무릎·발목을 가로지르는 생체형 장텐던). -->
  <tendon>
    <spatial name="FL_toe_f1_t" width="0.0012" rgba="0.9 0.4 0.2 0.8">
      <site site="FL_spool_f1"/><site site="FL_pulley_f1"/><site site="FL_toe_f1_insert"/>
    </spatial>
    <spatial name="FL_toe_f2_t" width="0.0012" rgba="0.9 0.4 0.2 0.8">
      <site site="FL_spool_f2"/><site site="FL_pulley_f2"/><site site="FL_toe_f2_insert"/>
    </spatial>
    <spatial name="FL_toe_b_t" width="0.0012" rgba="0.9 0.4 0.2 0.8">
      <site site="FL_spool_b"/><site site="FL_calf_back"/><site site="FL_pulley_b"/><site site="FL_toe_b_insert"/>
    </spatial>
    <spatial name="FR_toe_f1_t" width="0.0012" rgba="0.9 0.4 0.2 0.8">
      <site site="FR_spool_f1"/><site site="FR_pulley_f1"/><site site="FR_toe_f1_insert"/>
    </spatial>
    <spatial name="FR_toe_f2_t" width="0.0012" rgba="0.9 0.4 0.2 0.8">
      <site site="FR_spool_f2"/><site site="FR_pulley_f2"/><site site="FR_toe_f2_insert"/>
    </spatial>
    <spatial name="FR_toe_b_t" width="0.0012" rgba="0.9 0.4 0.2 0.8">
      <site site="FR_spool_b"/><site site="FR_calf_back"/><site site="FR_pulley_b"/><site site="FR_toe_b_insert"/>
    </spatial>
    <spatial name="RL_toe_f1_t" width="0.0012" rgba="0.9 0.4 0.2 0.8">
      <site site="RL_spool_f1"/><site site="RL_pulley_f1"/><site site="RL_toe_f1_insert"/>
    </spatial>
    <spatial name="RL_toe_f2_t" width="0.0012" rgba="0.9 0.4 0.2 0.8">
      <site site="RL_spool_f2"/><site site="RL_pulley_f2"/><site site="RL_toe_f2_insert"/>
    </spatial>
    <spatial name="RL_toe_b_t" width="0.0012" rgba="0.9 0.4 0.2 0.8">
      <site site="RL_spool_b"/><site site="RL_calf_back"/><site site="RL_pulley_b"/><site site="RL_toe_b_insert"/>
    </spatial>
    <spatial name="RR_toe_f1_t" width="0.0012" rgba="0.9 0.4 0.2 0.8">
      <site site="RR_spool_f1"/><site site="RR_pulley_f1"/><site site="RR_toe_f1_insert"/>
    </spatial>
    <spatial name="RR_toe_f2_t" width="0.0012" rgba="0.9 0.4 0.2 0.8">
      <site site="RR_spool_f2"/><site site="RR_pulley_f2"/><site site="RR_toe_f2_insert"/>
    </spatial>
    <spatial name="RR_toe_b_t" width="0.0012" rgba="0.9 0.4 0.2 0.8">
      <site site="RR_spool_b"/><site site="RR_calf_back"/><site site="RR_pulley_b"/><site site="RR_toe_b_insert"/>
    </spatial>
  </tendon>

  <!-- ================= 액추에이터 ================= -->
  <actuator>
    <!-- 허리(상하체 연결): XM430 위치 서보 3축 (팬/틸트/롤) -->
    <position name="spine_yaw_act" joint="spine_yaw" class="xm430" ctrlrange="-0.35 0.35"/>
    <position name="spine_pitch_act" joint="spine_pitch" class="xm430" ctrlrange="-0.3 0.3"/>
    <position name="spine_roll_act" joint="spine_roll" class="xm430" ctrlrange="-0.25 0.25"/>
    <!-- 목: XL430 위치 서보 -->
    <position name="neck_yaw_act" joint="neck_yaw" class="xl430" ctrlrange="-1.2 1.2"/>
    <position name="neck_pitch_act" joint="neck_pitch" class="xl430" ctrlrange="-0.9 0.6"/>
    <!-- 다리: XM430(힙외전/힙피치/무릎) + XL430(발목) 위치 서보 -->
    <position name="FL_abd_act" joint="FL_abd" class="xm430" ctrlrange="-0.5 0.5"/>
    <position name="FL_hip_act" joint="FL_hip_pitch" class="xm430" ctrlrange="-1.5 1.5"/>
    <position name="FL_knee_act" joint="FL_knee" class="xm430" ctrlrange="-2.4 -0.3"/>
    <position name="FL_ankle_act" joint="FL_ankle" class="xl430" ctrlrange="-0.8 1.2"/>
    <position name="FR_abd_act" joint="FR_abd" class="xm430" ctrlrange="-0.5 0.5"/>
    <position name="FR_hip_act" joint="FR_hip_pitch" class="xm430" ctrlrange="-1.5 1.5"/>
    <position name="FR_knee_act" joint="FR_knee" class="xm430" ctrlrange="-2.4 -0.3"/>
    <position name="FR_ankle_act" joint="FR_ankle" class="xl430" ctrlrange="-0.8 1.2"/>
    <position name="RL_abd_act" joint="RL_abd" class="xm430" ctrlrange="-0.5 0.5"/>
    <position name="RL_hip_act" joint="RL_hip_pitch" class="xm430" ctrlrange="-1.5 1.5"/>
    <position name="RL_knee_act" joint="RL_knee" class="xm430" ctrlrange="-2.4 -0.3"/>
    <position name="RL_ankle_act" joint="RL_ankle" class="xl430" ctrlrange="-0.8 1.2"/>
    <position name="RR_abd_act" joint="RR_abd" class="xm430" ctrlrange="-0.5 0.5"/>
    <position name="RR_hip_act" joint="RR_hip_pitch" class="xm430" ctrlrange="-1.5 1.5"/>
    <position name="RR_knee_act" joint="RR_knee" class="xm430" ctrlrange="-2.4 -0.3"/>
    <position name="RR_ankle_act" joint="RR_ankle" class="xl430" ctrlrange="-0.8 1.2"/>
    <!-- 발가락 텐던: XL330 스풀. 당김(장력) 전용, ctrl = 장력[N] 0~15 -->
    <motor name="FL_toe_f1_act" tendon="FL_toe_f1_t" gear="-1" ctrlrange="0 30"/>
    <motor name="FL_toe_f2_act" tendon="FL_toe_f2_t" gear="-1" ctrlrange="0 30"/>
    <motor name="FL_toe_b_act" tendon="FL_toe_b_t" gear="-1" ctrlrange="0 30"/>
    <motor name="FR_toe_f1_act" tendon="FR_toe_f1_t" gear="-1" ctrlrange="0 30"/>
    <motor name="FR_toe_f2_act" tendon="FR_toe_f2_t" gear="-1" ctrlrange="0 30"/>
    <motor name="FR_toe_b_act" tendon="FR_toe_b_t" gear="-1" ctrlrange="0 30"/>
    <motor name="RL_toe_f1_act" tendon="RL_toe_f1_t" gear="-1" ctrlrange="0 30"/>
    <motor name="RL_toe_f2_act" tendon="RL_toe_f2_t" gear="-1" ctrlrange="0 30"/>
    <motor name="RL_toe_b_act" tendon="RL_toe_b_t" gear="-1" ctrlrange="0 30"/>
    <motor name="RR_toe_f1_act" tendon="RR_toe_f1_t" gear="-1" ctrlrange="0 30"/>
    <motor name="RR_toe_f2_act" tendon="RR_toe_f2_t" gear="-1" ctrlrange="0 30"/>
    <motor name="RR_toe_b_act" tendon="RR_toe_b_t" gear="-1" ctrlrange="0 30"/>
  </actuator>

  <!-- ================= 센서 ================= -->
  <sensor>
    <!-- 관절 회전각/각속도: 전 관절 33개 -->
    <jointpos name="spine_yaw_pos" joint="spine_yaw"/>
